{
  "name": "pasif-gelirim",
  "version": "0.3.0",
  "private": true,
  "description": "Pasif Gelirim - kendi dijital işini adım adım kur",
  "scripts": {
    "test": "node test/core.test.js",
    "test:e2e": "node test/e2e.js",
    "serve": "npx --yes serve www -l 5173",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "branding": "python3 tools/apply_branding.py android/app/src/main/res branding/logo.png",
    "capacitor:sync:after": "python3 tools/apply_branding.py android/app/src/main/res branding/logo.png"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
